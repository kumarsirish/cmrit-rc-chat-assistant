# Template for .streamlit/secrets.toml — copy this file to
# .streamlit/secrets.toml (gitignored — never commit the real one) and
# fill in real values before setting config.yaml's app.require_google_login
# to true.
#
# How to get these values:
# 1. Go to https://console.cloud.google.com/apis/credentials (create a
#    project first if you don't have one).
# 2. "Create Credentials" -> "OAuth client ID" -> Application type "Web
#    application".
# 3. Under "Authorized redirect URIs", add this app's redirect_uri value
#    below, exactly as written (including the /oauth2callback path).
# 4. Copy the generated "Client ID" and "Client secret" into client_id /
#    client_secret below.
#
# cookie_secret is NOT from Google — generate your own random string,
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"

[auth]
# This app's own URL + "/oauth2callback" — must exactly match an
# "Authorized redirect URI" configured on the Google OAuth client above.
# Update this when deploying somewhere other than localhost.
redirect_uri = "http://localhost:8502/oauth2callback"
# Random secret Streamlit uses to sign the login session cookie — not
# a Google value, generate your own (see note above).
cookie_secret = "replace-with-a-long-random-string"
client_id = "replace-with-your-google-oauth-client-id"
client_secret = "replace-with-your-google-oauth-client-secret"
# Google's OIDC discovery document — this URL is the same for every
# Google OAuth client, nothing to customize here.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
